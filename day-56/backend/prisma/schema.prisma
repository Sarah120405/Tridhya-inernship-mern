generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String           @id @default(cuid())
  name                     String
  email                    String           @unique
  password                 String
  role                     Role             @default(Customer)
  isActive                 Boolean          @default(true)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  internalNotes            InternalNote[]
  messages                 Message[]
  assignedTickets          Ticket[]         @relation("AgentTickets")
  assignedDeveloperTickets Ticket[]         @relation("DeveloperTickets")
  createdTickets           Ticket[]         @relation("CustomerTickets")
  ticketActivities         TicketActivity[]
}

model Ticket {
  id                  String           @id @default(cuid())
  ticketNumber        Int              @unique @default(autoincrement())
  title               String
  description         String
  attachments         Json?
  customerId          String
  assignedAgentId     String?
  category            TicketCategory
  priority            TicketPriority   @default(MEDIUM)
  status              TicketStatus     @default(OPEN)
  resolvedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  assignedDeveloperId String?
  aiAnalyses          AIAnalysis[]
  internalNotes       InternalNote[]
  messages            Message[]
  sla                 SLA?
  assignedAgent       User?            @relation("AgentTickets", fields: [assignedAgentId], references: [id])
  assignedDeveloper   User?            @relation("DeveloperTickets", fields: [assignedDeveloperId], references: [id])
  customer            User             @relation("CustomerTickets", fields: [customerId], references: [id])
  activities          TicketActivity[]

  @@index([customerId])
  @@index([assignedAgentId])
  @@index([assignedDeveloperId])
  @@index([status])
  @@index([priority])
  @@index([category])
}

model Message {
  id            String   @id @default(cuid())
  ticketId      String
  senderId      String
  content       String
  isAIGenerated Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sender        User     @relation(fields: [senderId], references: [id])
  ticket        Ticket   @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([senderId])
}

model TicketActivity {
  id        String               @id @default(cuid())
  ticketId  String
  userId    String
  action    TicketActivityAction
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  ticket    Ticket               @relation(fields: [ticketId], references: [id])
  user      User                 @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
}

model InternalNote {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  ticket    Ticket   @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([authorId])
}

model SLA {
  id                         String    @id @default(cuid())
  ticketId                   String    @unique
  dueAt                      DateTime
  breached                   Boolean   @default(false)
  breachedAt                 DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  firstRespondedAt           DateTime?
  firstResponseDueAt         DateTime?
  resolutionCompletedAt      DateTime?
  resolutionDueAt            DateTime?
  firstResponseWarningSentAt DateTime?
  resolutionWarningSentAt    DateTime?
  ticket                     Ticket    @relation(fields: [ticketId], references: [id])
}

model AIAnalysis {
  id                      String          @id @default(cuid())
  ticketId                String
  type                    AIAnalysisType

  confidence              Float?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  suggestedCategory     TicketCategory?
  suggestedPriority     TicketPriority?
  reasoning             String?

  suggestedResponse     String?
  escalationRecommended Boolean?
  escalationReason      String?
  responseUsed          Boolean?
  escalationAccepted    Boolean?

  issueSummary                String?
  observedBehavior            String?
  troubleshootingAttempted    String?
  relevantTechnicalDetails    String?
  customerImpact              String?
  developerInvestigation      String?
  summaryUsed                 Boolean?

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([type])
}

enum AIAnalysisType {
  TICKET_SUGGESTION
  AGENT_RESPONSE
  AGENT_ESCALATION
  DEVELOPER_SUMMARY
}

enum Role {
  Customer
  SupportAgent
  Admin
  Developer
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
  ESCALATED
  IN_DEVELOPMENT
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  TECHNICAL
  BILLING
  ACCOUNT
  FEATURE_REQUEST
  GENERAL_INQUIRY
  OTHER
}

enum TicketActivityAction {
  TICKET_CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  AGENT_ASSIGNED
  AGENT_REASSIGNED
  TICKET_RESOLVED
  TICKET_CLOSED
  DEVELOPER_ASSIGNED
  DEVELOPER_REASSIGNED
  TICKET_ESCALATED
  DEVELOPER_UPDATED
}
